{"id":"rdb-7094b9","type":"COMMENT","payload":{"id":"cmt-e4d2832f-c398-4369-8acd-6c335bbcdce3","text":"Rescoped and completed. Added a CLI reference table between \"Synchronize an existing project\" and \"Embedded use\" listing all 11 commands with descriptions pulled from the source. Consolidated M5 into a single checked roadmap item."},"created_at":"2026-09-17T10:11:19.131987Z","created_by":"claude-code/2.1.273 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"mcp"}
