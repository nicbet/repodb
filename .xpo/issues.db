{"id":"rdb-e472aa","type":"UPDATE","payload":{"title":"Journal writes skip secondary indexes with persisted trees (UNIQUE violated)","assignee":"Claude Code \u003cagent@macbook.local\u003e","dependencies":null,"labels":null},"created_at":"2026-09-28T09:53:37.752071Z","created_by":"claude-code/2.1.283 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"mcp"}
